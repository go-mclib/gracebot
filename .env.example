# GraceBot requires a tool-capable OpenAI-compatible chat model.
# Set real credentials in your shell or ignored .envrc, never in this file.
# Existing GROQ_API_KEY setups still select Groq/llama-3.3-70b-versatile automatically.
# OPENAI_API_KEY selects OpenAI/gpt-4o-mini when GROQ_API_KEY is unset.
# LLM_API_KEY takes precedence and defaults to the OpenAI endpoint.

# Generic provider configuration (optional when using GROQ_API_KEY or OPENAI_API_KEY):
# export LLM_API_KEY='your-key'
# export LLM_BASE_URL='https://api.groq.com/openai/v1'
# export LLM_MODEL='llama-3.3-70b-versatile'

# Anthropic Haiku (the existing client uses Anthropic's OpenAI-compatible endpoint):
# export ANTHROPIC_API_KEY='your-key'
# export LLM_API_KEY="$ANTHROPIC_API_KEY"
# export LLM_BASE_URL='https://api.anthropic.com/v1'
# export LLM_MODEL='claude-haiku-4-5-20251001'

# Online Minecraft authentication uses AZURE_CLIENT_ID as before.
# export AZURE_CLIENT_ID='your-application-client-id'

# Matching is case-insensitive substring containment.
# The authenticated/current Minecraft username is always recognized.
# CLI -a overrides this value. Set '' for username-only matching.
export GRACEBOT_ALIASES='grace,steedsgate,steeds'

# Run: go run . -s steedsgate.quest -u SteedsGate
# Offline: go run . -online=false -u GraceBot -s localhost:25565
# Examples: "grace lets play hangman", then "guess e", then "stop the game"
# A mention starts a per-player conversation; follow-ups need no repeated mention.
# Incoming messages are batched after 2s of quiet (-chat-debounce).
# The model can continue, silently wait for unfinished input, or disengage.
# Incoming silence expires engagement after 1m; replies/tools never refresh it.
# -conversation-timeout=0 requires mentions. ! commands do not exist.
# Responses use the respond tool only: normally one short message, no speaker
# prefixes or free-form model commentary. Bukkit colors and MiniMessage survive
# unchanged; server permissions determine which formatting is rendered.
# Games are shared; anyone can play. Owners/admins can stop games.
# Singing requires trusted/admin; rank changes require admins.json membership.
# Singing negotiates Simple Voice Chat v20 on demand. Install ffmpeg (with libopus)
# and yt-dlp on PATH for voice music; a supported JS runtime such as Deno is
# recommended for YouTube. No CGO is needed to build the bot.
# Music searches use the selected lyrics' title, artist and recording duration.
# YouTube is tried first, then matching public SoundCloud tracks; DRM and previews
# are not unlocked. Missing voice chat or unavailable audio leaves lyrics in chat.
# LRC timestamps follow transmitted 20ms audio frames; plain lyrics retain the
# existing two-second spacing. Output pacing is 1.1s and at most five per 10.1s.
# singing_status reports loading/playing state, voice, synced and fallback reason.
# Stop/disconnect cancels music downloads, encoding and lyrics together.
# UUID-attributed public player chat (including Paper's raw renderer) starts
# conversations. Private player messages are archived for owner-only retrieval.
# Unattributed system/private/disguised traffic is quarantined, not authority.
# Player-hiding plugins such as ComplementaryAnticheat can make Paper strip the
# sender UUID from public chat. Such messages intentionally cannot trigger tools:
# fix the server-side visibility integration, never trust display names as actors.

# Optional personality.txt is loaded at runtime, not required to build.
# SQLite state defaults to gracebot.db (-database), with private WAL/SHM files.
# admins.json (-admins) remains the source of administrator membership.
# -import-data defaults to player_data.json; -import-history to chat_history.jsonl.
# Legacy imports are atomic, idempotent and leave originals untouched. Changed or
# corrupt sources fail closed; pass -import-data= -import-history= to disable them.
# Statistics derive from retained public events and observed presence, never
# private whispers or parallel counters. Offline gaps are excluded. Untimed
# legacy aggregates remain separate; scores/ranks/curated memories do not expire.
# memory_remember/search/update/forget store attributed public or owner-private
# facts. Private source provenance cannot be promoted to public memory.
# chat_history supports literal substring or RE2 regex, UTC timestamp bounds,
# case-insensitive player filters and ID cursors. Automatic context is bounded
# and public-only. Reading private data makes replies private for that conversation;
# unavailable whisper transport never falls back to public broadcast.
# Retention is seven UTC calendar dates including today, not unbounded history.
# Completed days become private gzip JSONL files under chat_archives/ (-archives).
# Startup/minute maintenance archives late arrivals, purges expired data and
# checkpoints SQLite. Back up the database and archives together.
#
# server_command runs as this Minecraft account, never shell/server console.
# Anyone may discover command names and use plugins/help/version/list; other
# commands require trusted/admin. Feedback is private, bounded and uncorrelated:
# submitted is not proof of success. Minecraft permissions still apply.
# move_to/follow_entity/build_arrangement/mount_entity/dismount/fight_entity need
# trusted/admin. One cancellable job runs at a time, within 32 blocks and 120s.
# Survival builds support up to 64 inert blocks in 8x4x8, consume real inventory,
# require support/access and await server confirmations; no replacement/rollback.
# Mounting supports boats/rafts/plain minecarts with an empty hand or offhand.
# Combat handles navigation/reach/line-of-sight/weapon cooldown; players are excluded.
# stop_action is an emergency stop available to everyone. Disconnect/death,
# unloaded targets and deadlines end jobs; check action_status for actual outcomes.
#
# Isolated loopback testing only: -console-chat admits server /say as unprivileged
# @server; plugins can issue /say, so it never grants operator authority.
# -console-input accepts privileged @console requests from this process's stdin;
# replies stay in the operator console. Both flags require a literal loopback IP.
# Example: go run . -online=false -u GraceLocal -s 127.0.0.1:25576 -console-input
#
# Multiple tools may be used in one reply (up to 16 calls across 6 tool rounds).
# online_players reads tablist names, display text, ping, header and footer.
# player_position/player_equipment expose only currently tracked loaded players;
# out-of-range is unknown, not offline. No other player's private inventory.
# nearby_entities, bot_status, inventory and inspect_block read the bot's loaded
# surroundings; minecraft_item looks up bundled vanilla item registry entries.
# duckduckgo_search returns real results/snippets; challenges remain errors.
# fetch_website is HTTPS-only on exact allowed hosts/paths (see web_sources):
# Wikipedia, BBC, Reuters, Minecraft Wiki/Minecraft.net, PaperMC, Modrinth,
# Yahoo Finance and Investopedia. No arbitrary hosts, query parameters, proxies,
# scripts/subresources or private-network addresses, including after redirects.
# stock_quote reads Yahoo's public chart endpoint with currency and trade time;
# prices may be delayed/stale and are not a guaranteed real-time trading feed.

# The current local changes use ../client and ../data-gracebot through go.work.
# data-gracebot is an isolated worktree; the unrelated ../data edits are untouched.
# The unpublished github.com/go-mclib/nbt module must exist at ../nbt.
# Keep go.work until the corresponding client/data changes are published.
# Fetching private go-mclib revisions may require GitHub access and
# GOPRIVATE=github.com/go-mclib/* in your Go environment.
